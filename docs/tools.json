{
  "tools": [
    {
      "name": "send_command",
      "inputSchema": {
        "type": "object",
        "properties": {
          "command": {"type": "string"},
          "wait": {"type": "boolean", "default": true},
          "timeout_sec": {"type": "number", "minimum": 0.1, "maximum": 1800},
          "poll_interval_sec": {"type": "number", "minimum": 0.01, "maximum": 5.0, "default": 0.1}
        },
        "required": ["command", "timeout_sec"]
      }
    },
    {
      "name": "run_lisp",
      "inputSchema": {
        "type": "object",
        "properties": {
          "expr": {"type": "string"},
          "wait": {"type": "boolean", "default": true},
          "timeout_sec": {"type": "number", "minimum": 0.1, "maximum": 1800}
        },
        "required": ["expr", "timeout_sec"]
      }
    },
    {
      "name": "load_lisp_file",
      "inputSchema": {
        "type": "object",
        "properties": {
          "path": {"type": "string"},
          "wait": {"type": "boolean", "default": true},
          "timeout_sec": {"type": "number", "minimum": 0.1, "maximum": 1800}
        },
        "required": ["path", "timeout_sec"]
      }
    },
    {
      "name": "get_last_output",
      "inputSchema": {
        "type": "object",
        "properties": {
          "source": {
            "type": "string",
            "enum": ["lastprompt", "logfile"],
            "default": "logfile"
          }
        },
        "required": []
      }
    },
    {
      "name": "start_logging",
      "inputSchema": {
        "type": "object",
        "properties": {
          "mode": {
            "type": "string",
            "enum": ["logfile", "lastprompt"],
            "default": "logfile"
          },
          "logfile_path": {"type": ["string", "null"], "default": null},
          "reset": {"type": "boolean", "default": false}
        },
        "required": []
      }
    },
    {
      "name": "get_new_output_since",
      "inputSchema": {
        "type": "object",
        "properties": {
          "stream_id": {"type": "string"},
          "cursor": {"type": "integer", "minimum": 0},
          "max_bytes": {"type": "integer", "minimum": 1, "default": 65536}
        },
        "required": ["stream_id", "cursor"]
      }
    },
    {
      "name": "stop_logging",
      "inputSchema": {
        "type": "object",
        "properties": {
          "stream_id": {"type": "string"}
        },
        "required": ["stream_id"]
      }
    },
    {
      "name": "get_status",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "required": []
      }
    },
    {
      "name": "dict_list",
      "inputSchema": {
        "type": "object",
        "properties": {
          "timeout_sec": {"type": "number", "minimum": 0.1, "maximum": 1800}
        },
        "required": ["timeout_sec"]
      }
    },
    {
      "name": "dict_xrecord_get",
      "inputSchema": {
        "type": "object",
        "properties": {
          "dict_name": {"type": "string"},
          "key": {"type": "string"},
          "timeout_sec": {"type": "number", "minimum": 0.1, "maximum": 1800}
        },
        "required": ["dict_name", "key", "timeout_sec"]
      }
    },
    {
      "name": "dict_keys",
      "inputSchema": {
        "type": "object",
        "properties": {
          "dict_name": {"type": "string"},
          "timeout_sec": {"type": "number", "minimum": 0.1, "maximum": 1800}
        },
        "required": ["dict_name", "timeout_sec"]
      }
    },
    {
      "name": "dict_xrecord_set",
      "inputSchema": {
        "type": "object",
        "properties": {
          "dict_name": {"type": "string"},
          "key": {"type": "string"},
          "values": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "code": {"type": "integer"},
                "value": {"type": ["string", "number", "boolean", "array", "null"]}
              },
              "required": ["code", "value"]
            }
          },
          "timeout_sec": {"type": "number", "minimum": 0.1, "maximum": 1800},
          "overwrite": {"type": "boolean", "default": true}
        },
        "required": ["dict_name", "key", "values", "timeout_sec"]
      }
    },
    {
      "name": "dict_xrecord_delete",
      "inputSchema": {
        "type": "object",
        "properties": {
          "dict_name": {"type": "string"},
          "key": {"type": "string"},
          "timeout_sec": {"type": "number", "minimum": 0.1, "maximum": 1800}
        },
        "required": ["dict_name", "key", "timeout_sec"]
      }
    },
    {
      "name": "dict_delete",
      "inputSchema": {
        "type": "object",
        "properties": {
          "dict_name": {"type": "string"},
          "timeout_sec": {"type": "number", "minimum": 0.1, "maximum": 1800},
          "recursive": {"type": "boolean", "default": true}
        },
        "required": ["dict_name", "timeout_sec"]
      }
    },
    {
      "name": "selection",
      "inputSchema": {
        "type": "object",
        "properties": {
          "timeout_sec": {"type": "number", "minimum": 0.1, "maximum": 1800},
          "prompt": {"type": ["string", "null"], "default": null},
          "filter": {
            "type": ["array", "null"],
            "default": null,
            "items": {
              "type": "object",
              "properties": {
                "code": {"type": "integer"},
                "value": {"type": ["string", "number", "boolean", "array", "null"]}
              },
              "required": ["code", "value"]
            }
          },
          "max_objects": {"type": ["integer", "null"], "default": null}
        },
        "required": ["timeout_sec"]
      }
    }
  ]
}
